msgctxt "Addon Summary"
msgid "A Script for editing Kodi's built in RSS Ticker"
msgstr "Ett skript för att redigera Kodis inbyggda RSS-ticker"

msgctxt "Addon Description"
msgid "A Script for editing Kodi's built in RSS Ticker"
msgstr "Ett skript för att redigera Kodis inbyggda RSS-ticker"

msgctxt "#32000"
msgid "RSS Editor"
msgstr "RSS-redigerare"

msgctxt "#32001"
msgid "Change Set"
msgstr "Ändra uppsättning"

msgctxt "#32002"
msgid "items"
msgstr "objekt"

msgctxt "#32003"
msgid "Pages"
msgstr "Sidor"

msgctxt "#32006"
msgid "Edit Attributes"
msgstr "Redigera attribut"

msgctxt "#32012"
msgid "RSS Feed URL"
msgstr "URL för RSS-flöde"

msgctxt "#32013"
msgid "Update Interval"
msgstr "Uppdateringsintervall"

msgctxt "#32014"
msgid "Enter the paths of your RSS feeds %s"
msgstr "Ange sökvägarna till dina RSS-flöden %s"

msgctxt "#32024"
msgid "Select a Set "
msgstr "Välj en uppsättning "

msgctxt "#32025"
msgid "Set ID"
msgstr "Uppsättnings-id"

msgctxt "#32027"
msgid "Enable Right to Left Text for this Set?"
msgstr "Aktivera höger till vänster-text för denna uppsättning?"

msgctxt "#32030"
msgid "Set Editor"
msgstr "Uppsättningsredigerare"

msgctxt "#32040"
msgid "Error: "
msgstr "Fel: "

msgctxt "#32041"
msgid "was either not found in the system,"
msgstr "hittades antingen inte i systemet,"

msgctxt "#32042"
msgid "or does not contain parsable XML."
msgstr "eller innehåller inte tolkningsbar XML."

msgctxt "#32043"
msgid "Try deleting it from your userdata folder and restarting XBMC."
msgstr "Försök att ta bort den från din userdata-mapp och starta om XBMC."

msgctxt "#32045"
msgid "Cannot Delete Set 1"
msgstr "Kan inte ta bort uppsättning 1"

msgctxt "#32046"
msgid "Set 1 is required.  You cannot delete this."
msgstr "Uppsättning 1 krävs.  Du kan inte ta bort denna."

msgctxt "#32047"
msgid "Reset set 1 to default?"
msgstr "Nollställ uppsättning 1 till standard?"

msgctxt "#32050"
msgid "Set %s already exists."
msgstr "Uppsättningen %s finns redan."

msgctxt "#32051"
msgid "Your RSSFeeds.xml file is corrupt."
msgstr "Filen RSSFeeds.xml är skadad."

msgctxt "#32052"
msgid "Attempt to regenerate"
msgstr "Försöker att återgenerera"

msgctxt "#32053"
msgid "You will loose all previous settings"
msgstr "Du kommer att förlora alla tidigare inställningar"
