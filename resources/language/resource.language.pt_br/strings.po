msgctxt "Addon Summary"
msgid "A Script for editing Kodi's built in RSS Ticker"
msgstr "Um script para editar o RSS Ticker integrado do Kodi"

msgctxt "Addon Description"
msgid "A Script for editing Kodi's built in RSS Ticker"
msgstr "Um script para editar o RSS Ticker integrado do Kodi"

msgctxt "#32000"
msgid "RSS Editor"
msgstr "Editor RSS"

msgctxt "#32001"
msgid "Change Set"
msgstr "Mudar Definição"

msgctxt "#32002"
msgid "items"
msgstr "itens"

msgctxt "#32003"
msgid "Pages"
msgstr "Páginas"

msgctxt "#32006"
msgid "Edit Attributes"
msgstr "Editar Atributos"

msgctxt "#32012"
msgid "RSS Feed URL"
msgstr "URL do feed RSS"

msgctxt "#32013"
msgid "Update Interval"
msgstr "Intervalo de atualização"

msgctxt "#32014"
msgid "Enter the paths of your RSS feeds %s"
msgstr "Insira os caminhos dos seus feeds RSS %s"

msgctxt "#32024"
msgid "Select a Set "
msgstr "Selecionar uma Definição· "

msgctxt "#32025"
msgid "Set ID"
msgstr "Definir ID"

msgctxt "#32027"
msgid "Enable Right to Left Text for this Set?"
msgstr "Ativar Texto da Direita para a Esquerda para esta Definição?"

msgctxt "#32030"
msgid "Set Editor"
msgstr "Definir Editor"

msgctxt "#32040"
msgid "Error: "
msgstr "Erro: "

msgctxt "#32041"
msgid "was either not found in the system,"
msgstr "ou não foi encontrado no sistema,"

msgctxt "#32042"
msgid "or does not contain parsable XML."
msgstr "ou não contém XML analisável."

msgctxt "#32043"
msgid "Try deleting it from your userdata folder and restarting XBMC."
msgstr "Tente excluí-lo da pasta userdata e reiniciar o XBMC."

msgctxt "#32045"
msgid "Cannot Delete Set 1"
msgstr "Não foi Possível Excluir a Definição 1"

msgctxt "#32046"
msgid "Set 1 is required.  You cannot delete this."
msgstr "A Definição 1 é obrigatória. · · Você não pode excluir isso."

msgctxt "#32047"
msgid "Reset set 1 to default?"
msgstr "Redefinir a definição 1 para o padrão?"

msgctxt "#32050"
msgid "Set %s already exists."
msgstr "Definição %s já existe."

msgctxt "#32051"
msgid "Your RSSFeeds.xml file is corrupt."
msgstr "Seu arquivo RSSFeeds.xml está corrompido."

msgctxt "#32052"
msgid "Attempt to regenerate"
msgstr "Tentar regenerar"

msgctxt "#32053"
msgid "You will loose all previous settings"
msgstr "Você perderá todas as configurações anteriores"
